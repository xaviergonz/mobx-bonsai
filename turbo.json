{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "build-docs": {
      "dependsOn": ["build"],
      "outputs": ["api-docs/**", "../../apps/site/copy-to-build/api/**"],
      "inputs": ["src/**", "typedocconfig.js"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["MOBX-VERSION"]
    },
    "test:ci": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": ["MOBX-VERSION"]
    },
    "site#build": {
      "dependsOn": ["^build", "mobx-bonsai#build-docs"],
      "outputs": ["build/**"]
    },
    "site#serve": {
      "dependsOn": ["site#build"],
      "cache": false,
      "persistent": true
    },
    "site#start": {
      "dependsOn": ["^build", "mobx-bonsai#build-docs"],
      "cache": false,
      "persistent": true
    },
    "profiling#profile:node-creation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["out/**"]
    }
  }
}
