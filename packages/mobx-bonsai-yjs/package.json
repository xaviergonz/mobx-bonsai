{
  "name": "mobx-bonsai-yjs",
  "version": "2.1.2",
  "description": "Y.js two-way binding for mobx-bonsai",
  "keywords": [
    "mobx",
    "mobx-bonsai",
    "Y.js",
    "yjs",
    "state management",
    "observable"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xaviergonz/mobx-bonsai.git"
  },
  "bugs": {
    "url": "https://github.com/xaviergonz/mobx-bonsai/issues"
  },
  "homepage": "https://mobx-bonsai.js.org",
  "license": "MIT",
  "author": "Javier González Garcés",
  "source": "./src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "script": "./dist/mobx-bonsai-yjs.umd.js",
      "import": "./dist/mobx-bonsai-yjs.esm.mjs",
      "require": "./dist/mobx-bonsai-yjs.umd.js",
      "default": "./dist/mobx-bonsai-yjs.esm.mjs"
    }
  },
  "esmodule": "./dist/mobx-bonsai-yjs.esm.js",
  "module": "./dist/mobx-bonsai-yjs.esm.js",
  "jsnext:main": "./dist/mobx-bonsai-yjs.esm.js",
  "react-native": "./dist/mobx-bonsai-yjs.umd.js",
  "umd:main": "./dist/mobx-bonsai-yjs.umd.js",
  "unpkg": "./dist/mobx-bonsai-yjs.umd.js",
  "jsdelivr": "./dist/mobx-bonsai-yjs.umd.js",
  "main": "./dist/mobx-bonsai-yjs.umd.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src",
    "dist",
    "LICENSE",
    "CHANGELOG.md",
    "README.md",
    "logo.png"
  ],
  "scripts": {
    "quick-build": "tsc",
    "quick-build-tests": "tsc -p test",
    "copy-root-files": "shx cp ../../README.md . && shx cp ../../LICENSE . && shx cp ../../CHANGELOG.md . && shx cp ../../logo.png .",
    "build": "pnpm quick-build && pnpm copy-root-files && shx rm -rf dist && vite build && shx cp dist/mobx-bonsai-yjs.esm.mjs dist/mobx-bonsai-yjs.esm.js",
    "test": "vitest run",
    "test:ci": "vitest run --coverage"
  },
  "peerDependencies": {
    "mobx": "^6.0.0 || ^5.0.0 || ^4.0.0",
    "mobx-bonsai": "^2.0.0",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "mobx-bonsai": "workspace:*",
    "shx": "^0.4.0",
    "spec.ts": "^1.1.3",
    "ts-node": "^10.9.2",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "directories": {
    "test": "test"
  }
}
